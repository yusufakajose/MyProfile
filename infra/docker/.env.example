# LinkGrove Docker Compose Environment Variables
# Copy this file to .env and customize as needed: cp .env.example .env

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/linkgrove
SPRING_DATASOURCE_USERNAME=linkgrove
SPRING_DATASOURCE_PASSWORD=linkgrove

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# RabbitMQ
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672

# Security - CHANGE THIS IN PRODUCTION!
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=linkgrove_dev_secret_key_0123456789abcdef0123456789abcdef

# URLs
PUBLIC_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
REACT_APP_API_URL=/api

# Optional: OpenTelemetry tracing (requires Jaeger via "obs" profile)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# Optional: GeoIP analytics (requires MaxMind GeoLite2 database)
GEOIP_ENABLED=false
# GEOIP_DB_PATH=/geo/GeoLite2-Country.mmdb

# Optional: Social meta tags
# TWITTER_SITE=@yourhandle

# Development only - DO NOT ENABLE IN PRODUCTION
ENABLE_DEV_TOKEN_ENDPOINTS=false
